CONFIG_BOARD_QUALIA_5800=y
# CONFIG_BOARD_WAVESHARE_LCD is not set
CONFIG_PANEL_WAVESHARE_ST7701=y
# CONFIG_PANEL_YX40006ACT is not set
CONFIG_ST7701_PCLK_HZ=16407120
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# CONFIG_ESPTOOLPY_FLASHSIZE_8MB is not set
CONFIG_ESP32S3_DATA_CACHE_64KB=y
# CONFIG_ESP32S3_DATA_CACHE_32KB is not set
CONFIG_LV_DITHER_GRADIENT=y
# CONFIG_LV_DITHER_ERROR_DIFFUSION is not set
# CONFIG_QUALIA_BACKLIGHT_PWM is not set
